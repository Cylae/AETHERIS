# ==============================================================================
# AETHERIS CORE CONFIGURATION
# ==============================================================================

# Timezone (e.g., Europe/London, America/New_York)
TZ=UTC

# Host Paths for Data Persistence
AETHERIS_DATA_DIR=./data
AETHERIS_MEDIA_DIR=./media

# UID/GID to run containers as non-root (Match your host user)
PUID=1000
PGID=1000

# Primary Domain (e.g., example.com)
DOMAIN_NAME=example.com

# ==============================================================================
# SECRETS AND PASSWORDS
# ==============================================================================

# MariaDB Root Password
MYSQL_ROOT_PASSWORD=generate_secure_password_here

# Redis Password
REDIS_PASSWORD=generate_secure_password_here

# Nginx Proxy Manager Database Credentials
NPM_DB_PASSWORD=generate_secure_password_here

# Vaultwarden Admin Token (Generate via: openssl rand -base64 48)
ADMIN_TOKEN=generate_secure_token_here

# Nextcloud Credentials
NEXTCLOUD_DB_PASSWORD=generate_secure_password_here
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=generate_secure_password_here

# Gitea Database Password
GITEA_DB_PASSWORD=generate_secure_password_here

# Yourls Database and Admin Password
YOURLS_DB_PASSWORD=generate_secure_password_here
YOURLS_ADMIN_PASSWORD=generate_secure_password_here

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=generate_secure_password_here

# ==============================================================================
# MAIL SERVER CONFIGURATION
# ==============================================================================

# The hostname for your mail server (usually mail.yourdomain.com)
MAIL_HOSTNAME=mail.example.com

# Enable/Disable ClamAV Antivirus (0 or 1)
ENABLE_CLAMAV=1

# Enable/Disable SpamAssassin (0 or 1)
ENABLE_SPAMASSASSIN=1

# Enable/Disable Fail2Ban (0 or 1)
ENABLE_FAIL2BAN=1

# Postmaster Address
POSTMASTER_ADDRESS=postmaster@example.com

# Disable Debug Mode
DMS_DEBUG=0
