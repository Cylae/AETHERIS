-- ==============================================================================
-- AETHERIS MARIADB INITIALIZATION TEMPLATE
-- Principle of Least Privilege Database Provisioning
-- ==============================================================================
-- Passwords are generated dynamically during install.sh execution and substituted
-- into /docker-entrypoint-initdb.d/init-dbs.sql upon initial container bootstrap.
--
-- Note: Explicit DDL/DML permissions (SELECT, INSERT, UPDATE, DELETE, CREATE, DROP,
-- ALTER, INDEX, REFERENCES) are assigned instead of full administrative privileges
-- to restrict database account capabilities to application schema management and operational CRUD.

CREATE DATABASE IF NOT EXISTS `npm`;
CREATE USER IF NOT EXISTS 'npm'@'%' IDENTIFIED BY '${NPM_DB_PASSWORD}';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, INDEX, REFERENCES, CREATE TEMPORARY TABLES, LOCK TABLES ON `npm`.* TO 'npm'@'%';

CREATE DATABASE IF NOT EXISTS `nextcloud`;
CREATE USER IF NOT EXISTS 'nextcloud'@'%' IDENTIFIED BY '${NEXTCLOUD_DB_PASSWORD}';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, INDEX, REFERENCES, CREATE TEMPORARY TABLES, LOCK TABLES ON `nextcloud`.* TO 'nextcloud'@'%';

CREATE DATABASE IF NOT EXISTS `gitea`;
CREATE USER IF NOT EXISTS 'gitea'@'%' IDENTIFIED BY '${GITEA_DB_PASSWORD}';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, INDEX, REFERENCES, CREATE TEMPORARY TABLES, LOCK TABLES ON `gitea`.* TO 'gitea'@'%';

CREATE DATABASE IF NOT EXISTS `yourls`;
CREATE USER IF NOT EXISTS 'yourls'@'%' IDENTIFIED BY '${YOURLS_DB_PASSWORD}';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, INDEX, REFERENCES, CREATE TEMPORARY TABLES, LOCK TABLES ON `yourls`.* TO 'yourls'@'%';

FLUSH PRIVILEGES;
